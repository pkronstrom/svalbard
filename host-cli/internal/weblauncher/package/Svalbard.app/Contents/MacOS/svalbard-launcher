#!/bin/sh
# Finder can launch a shell wrapper under Rosetta. Select the vault's Mach-O
# for the actual hardware even when this process reports an Intel uname.
root=$(CDPATH= cd -P -- "$(dirname -- "$0")/../../.." && pwd -P) || exit 1
runtime="$root/.svalbard/runtime"
binary="$runtime/macos-x86_64/svalbard-drive"
if [ "$(/usr/sbin/sysctl -in hw.optional.arm64)" = "1" ] ||
   [ "$(/usr/sbin/sysctl -in sysctl.proc_translated)" = "1" ] ||
   [ "$(/usr/bin/uname -m)" = "arm64" ]; then
    if [ -x "$runtime/macos-arm64/svalbard-drive" ]; then
        binary="$runtime/macos-arm64/svalbard-drive"
    fi
fi
if [ -x "$binary" ]; then
    message=$(DRIVE_ROOT="$root" "$binary" launch 2>&1) && exit 0
    case "$message" in
        *"unknown command: launch"*) message="This drive has an older runtime. Try ./run web from the vault folder, or update the drive runtime and apply the web-launcher recipe with the Svalbard host." ;;
    esac
else
    message="Keep Svalbard.app beside the existing vault’s run file. This vault needs its Mac runtime and web-launcher recipe. Add the recipe with the Svalbard host and apply it to this vault. If macOS isolated the app, use a trusted local copy of the complete vault."
fi
/usr/bin/osascript - "$message" <<'APPLESCRIPT'
on run argv
    display alert "Svalbard could not open" message (item 1 of argv) as critical
end run
APPLESCRIPT
exit 1
