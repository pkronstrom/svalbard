#!/bin/sh
root=$(CDPATH= cd -P -- "$(dirname -- "$0")" && pwd -P) || exit 1
launch() (
    cd "$root" || exit 1
    # Older drives shipped a Bash dispatcher. Keep those drives usable on
    # minimal hosts that have a POSIX shell but no Bash.
    if ! command -v bash >/dev/null 2>&1; then
        IFS= read -r interpreter < ./run
        if [ "$interpreter" = '#!/usr/bin/env bash' ]; then
            case "$(uname -m)" in
                x86_64) arch=x86_64 ;;
                aarch64|arm64) arch=arm64 ;;
                *) printf 'Unsupported architecture: %s\n' "$(uname -m)" >&2; exit 1 ;;
            esac
            DRIVE_ROOT="$root"
            export DRIVE_ROOT
            exec "$root/.svalbard/runtime/linux-$arch/svalbard-drive" launch
        fi
    fi
    exec ./run launch
)
if [ -x "$root/run" ]; then
    message=$(launch 2>&1) && exit 0
    case "$message" in
        *"unknown command: launch"*) message="This drive has an older runtime. Try ./run web from the vault folder, or update the drive runtime and apply the web-launcher recipe with the Svalbard host." ;;
        *"/svalbard-drive:"*) message="The Linux drive runtime could not run. Apply the web-launcher recipe for this Linux architecture. $message" ;;
    esac
else
    message="Place Svalbard-Linux beside the existing vault’s executable run file and apply the web-launcher recipe. If this mount disallows execution, use a trusted local copy of the complete vault."
fi
printf '%s\n' "$message" >&2
if command -v zenity >/dev/null 2>&1; then
    zenity --error --title=Svalbard --no-markup --text="$message"
elif command -v kdialog >/dev/null 2>&1; then
    kdialog --title Svalbard --error "$message"
elif command -v notify-send >/dev/null 2>&1; then
    notify-send Svalbard "$message"
fi
exit 1
